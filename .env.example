# ============================================================
# Zora OS — variáveis de ambiente (copie para .env e preencha)
# ============================================================

# --- App ------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_SECRET=change-me-to-a-long-random-string-32-bytes-min
AUTH_SECRET=change-me-to-another-long-random-string-32-bytes

# --- PostgreSQL ----------------------------------------------
POSTGRES_USER=zora
POSTGRES_PASSWORD=zora_dev_password_change_me
POSTGRES_DB=zora
DATABASE_URL=postgres://zora:zora_dev_password_change_me@localhost:5432/zora

# --- Redis ----------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-compatible storage) ---------------------------
MINIO_ROOT_USER=zora_minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_password_min_8_chars
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=zora_minio_admin
MINIO_SECRET_KEY=change_me_minio_password_min_8_chars
MINIO_BUCKET=zora-media
MINIO_PUBLIC_URL=http://localhost:9000

# --- Evolution API (WhatsApp não-oficial via Baileys) --------
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=change_me_evolution_global_api_key
EVOLUTION_AUTHENTICATION_API_KEY=change_me_evolution_global_api_key

# --- WhatsApp Cloud API (Meta, oficial) ----------------------
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=change_me_meta_webhook_verify_token
META_GRAPH_VERSION=v21.0
WA_CLOUD_ACCESS_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_BUSINESS_ACCOUNT_ID=

# --- Instagram (Meta Graph) ----------------------------------
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- Telegram -------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change_me_telegram_webhook_secret

# --- Email (IMAP/SMTP) ---------------------------------------
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# --- LLM (multi-provider) ------------------------------------
# Valores aceitos: anthropic | openai | groq
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# --- OAuth providers (NextAuth) ------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Caddy / domínio público (produção) ----------------------
PUBLIC_DOMAIN=zora.local
ACME_EMAIL=admin@zora.local
