{
  "name": "zora-os",
  "version": "0.1.0",
  "private": true,
  "description": "Zora OS — plataforma de atendimento multicanal",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @zora/db generate",
    "db:migrate": "pnpm --filter @zora/db migrate",
    "db:push": "pnpm --filter @zora/db push",
    "db:studio": "pnpm --filter @zora/db studio",
    "db:seed": "pnpm --filter @zora/db seed",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "@playwright/test": "^1.49.0"
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  }
}
